# build intermediates
build/
.gradle/
app/build/

# locally built artifacts - the released APKs/AAB come from CI (see README).
# Note the leading slash: the emulator gate's scratch directory is ignored, while the
# screenshots it commits live in docs/screenshots/ and must stay tracked.
dist/
/screenshots/

# ide / os
.idea/
*.iml
.DS_Store
local.properties

# real signing material for your own releases (the committed keystore/ is a labeled demo key)
*.production.jks
*.production.keystore
