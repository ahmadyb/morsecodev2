    <!--  help  -->
    <string name="faq_q1">How does MorseCode work?</string>
    <string name="faq_a1">Two phones on the same Wi-Fi connect directly. If there\'s no shared network, Nearby Connections uses Bluetooth or Wi-Fi Direct.</string>
    <string name="faq_q2">Do I need internet?</string>
    <string name="faq_a2">No. Nothing leaves your local network. There is no account, no cloud, and no analytics.</string>
    <string name="faq_q3">Can I send and receive at the same time?</string>
    <string name="faq_a3">Yes. A phone can listen for senders while it queues its own outgoing files.</string>
    <string name="faq_q4">What is WebShare?</string>
    <string name="faq_a4">WebShare runs a small web server on your phone so any browser on the same Wi-Fi can browse, download, and upload files.</string>
    <string name="faq_q5">Where are my logs?</string>
    <string name="faq_a5">Settings \u203a System \u203a Logs. They stay on the device until you export them as a .txt file.</string>

