    <item name="mcAccentName">Orange</item>
  </style>

  <!-- Theme overlay: Orange on light -->
  <style name="McTheme.Light.Orange" parent="@style/McTheme.Light">
    <item name="android:colorAccent">@color/mc_accent_orange_light</item>
    <item name="mcAccentStart">@color/mc_accent_orange_light</item>
    <item name="mcAccentEnd">@color/mc_accent_orange_light_2</item>
