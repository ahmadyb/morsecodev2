    <item name="mcAccentStart">@color/mc_accent_blue_dark</item>
    <item name="mcAccentEnd">@color/mc_accent_blue_dark_2</item>
    <item name="mcAccentName">Blue</item>
  </style>

  <!-- Theme overlay: Blue on light -->
  <style name="McTheme.Light.Blue" parent="@style/McTheme.Light">
    <item name="android:colorAccent">@color/mc_accent_blue_light</item>
    <item name="mcAccentStart">@color/mc_accent_blue_light</item>
    <item name="mcAccentEnd">@color/mc_accent_blue_light_2</item>
    <item name="mcAccentName">Blue</item>
  </style>

</resources>
