  <!-- Theme overlay: Purple on dark -->
  <style name="McTheme.Dark.Purple" parent="@style/McTheme.Dark">
    <item name="android:colorAccent">@color/mc_accent_purple_dark</item>
    <item name="mcAccentStart">@color/mc_accent_purple_dark</item>
    <item name="mcAccentEnd">@color/mc_accent_purple_dark_2</item>
    <item name="mcAccentName">Purple</item>
  </style>

  <!-- Theme overlay: Purple on light -->
  <style name="McTheme.Light.Purple" parent="@style/McTheme.Light">
    <item name="android:colorAccent">@color/mc_accent_purple_light</item>
    <item name="mcAccentStart">@color/mc_accent_purple_light</item>
    <item name="mcAccentEnd">@color/mc_accent_purple_light_2</item>
