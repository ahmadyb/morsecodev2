  <!-- Theme overlay: Green on light -->
  <style name="McTheme.Light.Green" parent="@style/McTheme.Light">
    <item name="android:colorAccent">@color/mc_accent_green_light</item>
    <item name="mcAccentStart">@color/mc_accent_green_light</item>
    <item name="mcAccentEnd">@color/mc_accent_green_light_2</item>
    <item name="mcAccentName">Green</item>
